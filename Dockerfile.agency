FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 runner
COPY app/ ./app/
# The entrypoint assigns the newly mounted volume, then permanently drops root
# before importing the application or accepting any HTTP request.
EXPOSE 8000
CMD ["python", "-m", "app.agency_start"]
